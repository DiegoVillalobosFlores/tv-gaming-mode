+void InputListenerItem::setUpGamepad()
+{
+    m_gamepad = new GamepadListener(this);
+
+    connect(m_gamepad, &GamepadListener::navigationKeyPressed, this, [this](int key) {
+        if (!gamepadUsable()) {
+            return;
+        }
+
+        // The first navigation key press only turns navigation mode on without
+        // selecting anything, so nudge the mode on before forwarding a press of
+        // the select button. Otherwise the user has to move the d-pad once
+        // before the keyboard reacts to anything.
+        if (key == Qt::Key_Return && !m_keyboardNavigationActive) {
+            Q_EMIT keyNavigationPressed(Qt::Key_Down);
+            Q_EMIT keyNavigationReleased(Qt::Key_Down);
+        }
+
+        Q_EMIT keyNavigationPressed(key);
+    });
+
+    connect(m_gamepad, &GamepadListener::navigationKeyReleased, this, [this](int key) {
+        if (!gamepadUsable()) {
+            return;
+        }
+        Q_EMIT keyNavigationReleased(key);
+    });
+
+    connect(m_gamepad, &GamepadListener::actionTriggered, this, [this](GamepadListener::Action action, bool isRepeat) {
+        if (!PlasmaKeyboardSettings::self()->gamepadNavigationEnabled()) {
+            return;
+        }
+
+        // Backspace doubles as the summon button: while the keyboard is off
+        // screen there is nothing to delete, so bring it up instead. This
+        // mirrors Steam, where the same button opens its on-screen keyboard.
+        if (action == GamepadListener::Backspace && !gamepadUsable()) {
+            if (!isRepeat) {
+                requestShow();
+            }
+            return;
+        }
+
+        if (!gamepadUsable()) {
+            return;
+        }
+
+        switch (action) {
+        case GamepadListener::Backspace:
+            sendKeysym(XKB_KEY_BackSpace);
+            break;
+        case GamepadListener::Space:
+            sendKeysym(XKB_KEY_space);
+            break;
+        case GamepadListener::Enter:
+            sendKeysym(XKB_KEY_Return);
+            break;
+        case GamepadListener::Hide:
+            m_userDismissed = true;
+            QGuiApplication::inputMethod()->setVisible(false);
+            break;
+        }
+    });
+
+    connect(m_gamepad, &GamepadListener::shiftHeldChanged, this, [this](bool held) {
+        // Always forward the release, otherwise shift stays stuck on when the
+        // panel goes away while the trigger is still down.
+        if (held && !gamepadUsable()) {
+            return;
+        }
+        Q_EMIT gamepadShiftHeldChanged(held);
+    });
+
+    // The window only exists once the item is parented into the scene
+    connect(this, &QQuickItem::windowChanged, this, [this](QQuickWindow *newWindow) {
+        if (newWindow) {
+            connect(newWindow, &QWindow::visibleChanged, this, &InputListenerItem::updateGamepadGrab, Qt::UniqueConnection);
+        }
+        updateGamepadGrab();
+    });
+
+    m_gamepad->setEnabled(PlasmaKeyboardSettings::self()->gamepadNavigationEnabled());
+
+    connect(PlasmaKeyboardSettings::self(), &PlasmaKeyboardSettings::gamepadNavigationEnabledChanged, this, [this] {
+        m_gamepad->setEnabled(PlasmaKeyboardSettings::self()->gamepadNavigationEnabled());
+        updateGamepadGrab();
+    });
+    connect(PlasmaKeyboardSettings::self(), &PlasmaKeyboardSettings::gamepadExclusiveEnabledChanged, this, [this] {
+        updateGamepadGrab();
+    });
+}
+
+bool InputListenerItem::gamepadUsable() const
+{
+    if (!PlasmaKeyboardSettings::self()->gamepadNavigationEnabled()) {
+        return false;
+    }
+
+    // The window can have isVisible() = true, but not be shown by the compositor if the input panel is suppressed
+    return window() && window()->isExposed();
+}
+
+void InputListenerItem::updateGamepadGrab()
+{
+    if (!m_gamepad) {
+        return;
+    }
+
+    const bool shown = window() && window()->isVisible();
+    m_gamepad->setGrabbing(shown && PlasmaKeyboardSettings::self()->gamepadNavigationEnabled()
+                           && PlasmaKeyboardSettings::self()->gamepadExclusiveEnabled());
+}
+
+void InputListenerItem::sendKeysym(uint keysym)
+{
+    const auto timestamp = QDateTime::currentMSecsSinceEpoch();
+    m_input.keysym(timestamp, keysym, InputPlugin::Pressed, 0);
+    m_input.keysym(timestamp, keysym, InputPlugin::Released, 0);
+}
+
+void InputListenerItem::requestShow()
+{
+    static const auto service = QStringLiteral("org.kde.KWin");
+    static const auto path = QStringLiteral("/VirtualKeyboard");
+    static const auto interface = QStringLiteral("org.kde.kwin.VirtualKeyboard");
+
+    // Only bring the keyboard up when the focused window has a text field to
+    // type into. Without this the summon button would pop the keyboard open in
+    // the middle of a game, where it shares a face button with a game action.
+    // Asking for the keyboard back overrides the earlier dismissal
+    m_userDismissed = false;
+
+    auto query = QDBusMessage::createMethodCall(service, path, QStringLiteral("org.freedesktop.DBus.Properties"), QStringLiteral("Get"));
+    query << interface << QStringLiteral("activeClientSupportsTextInput");
+
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(query), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [](QDBusPendingCallWatcher *self) {
+        self->deleteLater();
+
+        const QDBusPendingReply<QDBusVariant> reply = *self;
+        if (reply.isError()) {
+            qCDebug(PlasmaKeyboard) << "Could not ask KWin about text input support:" << reply.error().message();
+            return;
+        }
+
+        if (!reply.value().variant().toBool()) {
+            return;
+        }
+
+        QDBusConnection::sessionBus().asyncCall(QDBusMessage::createMethodCall(service, path, interface, QStringLiteral("forceActivate")));
+    });
+}
