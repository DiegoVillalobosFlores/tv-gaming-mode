diff --git a/src/gamepadlistener.cpp b/src/gamepadlistener.cpp
new file mode 100644
index 0000000..c2ac93f
--- /dev/null
+++ b/src/gamepadlistener.cpp
@@ -0,0 +1,572 @@
+/*
