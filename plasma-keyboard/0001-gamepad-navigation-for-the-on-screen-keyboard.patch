+
+#include "gamepadlistener.h"
+#include "logging.h"
+
+#include <QDir>
+#include <QFileSystemWatcher>
+#include <QSocketNotifier>
+
+#include <libevdev/libevdev.h>
+
+#include <fcntl.h>
+#include <linux/input.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <utility>
+
+namespace
+{
+// Directory holding the evdev nodes. Watched for hotplugged controllers.
+constexpr auto INPUT_DIR = "/dev/input";
+
+// udev creates the device node before it finishes applying permissions, so
+// give it a moment before trying to open anything new.
+constexpr int RESCAN_DELAY_MS = 250;
+
+// Auto-repeat timings for held directions and held backspace, matching the
+// feel of the usual X11 keyboard repeat.
+constexpr int REPEAT_DELAY_MS = 350;
+constexpr int REPEAT_INTERVAL_MS = 110;
+
+// Fractions of the axis range at which the analog stick starts and stops
+// counting as a direction.
+constexpr double STICK_ENTER = 0.55;
+constexpr double STICK_LEAVE = 0.35;
+
+// Analog triggers count as pressed above this fraction of their range.
+constexpr double TRIGGER_THRESHOLD = 0.6;
+}
+
+GamepadListener::GamepadListener(QObject *parent)
+    : QObject(parent)
+    , m_watcher(new QFileSystemWatcher(this))
+{
+    m_rescanTimer.setSingleShot(true);
+    m_rescanTimer.setInterval(RESCAN_DELAY_MS);
+    connect(&m_rescanTimer, &QTimer::timeout, this, &GamepadListener::rescan);
+
+    m_repeatTimer.setSingleShot(false);
+    connect(&m_repeatTimer, &QTimer::timeout, this, &GamepadListener::onRepeatTimeout);
+
+    connect(m_watcher, &QFileSystemWatcher::directoryChanged, this, [this] {
+        m_rescanTimer.start();
+    });
+}
+
+GamepadListener::~GamepadListener()
+{
+    closeAll();
+}
+
+bool GamepadListener::isEnabled() const
+{
+    return m_enabled;
+}
+
+void GamepadListener::setEnabled(bool enabled)
+{
+    if (enabled == m_enabled) {
+        return;
+    }
+
+    m_enabled = enabled;
+
+    if (enabled) {
+        m_watcher->addPath(QString::fromLatin1(INPUT_DIR));
+        rescan();
+    } else {
+        m_watcher->removePaths(m_watcher->directories());
+        m_rescanTimer.stop();
+        closeAll();
+    }
+}
+
+bool GamepadListener::isGrabbing() const
+{
+    return m_grabbing;
+}
+
+void GamepadListener::setGrabbing(bool grabbing)
+{
+    if (grabbing == m_grabbing) {
+        return;
+    }
+
+    m_grabbing = grabbing;
+    updateGrab();
+
+    if (!grabbing) {
+        // Whatever was held down cannot be released anymore once we stop
+        // listening exclusively, so drop the state instead of getting stuck.
+        setNavigationKey(0);
+        setRepeatAction(m_repeatAction, false);
+        setShiftHeld(false);
+    }
+}
+
+bool GamepadListener::hasDevices() const
+{
+    return !m_devices.isEmpty();
+}
+
+bool GamepadListener::effectivelyGrabbing() const
+{
+    // Holding Home suspends the grab, see the BTN_MODE case in handleButton()
+    return m_grabbing && !m_homeHeld;
+}
+
+void GamepadListener::applyGrab(Device *device)
+{
+    if (device->fd < 0) {
+        return;
+    }
+
+    // Ignore failures: another client may already hold the grab, in which case
+    // we simply keep reading the events non-exclusively.
+    if (libevdev_grab(device->dev, effectivelyGrabbing() ? LIBEVDEV_GRAB : LIBEVDEV_UNGRAB) != 0) {
+        qCDebug(PlasmaKeyboard) << "Could not change grab state of" << device->path;
+    }
+}
+
+void GamepadListener::updateGrab()
+{
+    for (Device *device : std::as_const(m_devices)) {
+        applyGrab(device);
+    }
+}
+
+void GamepadListener::rescan()
+{
+    if (!m_enabled) {
+        return;
+    }
+
+    const QDir dir(QString::fromLatin1(INPUT_DIR));
+    const QStringList nodes = dir.entryList({QStringLiteral("event*")}, QDir::System);
+
+    QStringList present;
+    present.reserve(nodes.size());
+
+    const bool had = hasDevices();
+
+    for (const QString &node : nodes) {
+        const QString path = dir.absoluteFilePath(node);
+        present.append(path);
+
+        if (!m_devices.contains(path)) {
+            addDevice(path);
+        }
+    }
+
+    // Drop devices whose node disappeared without us noticing a read error
+    const QStringList known = m_devices.keys();
+    for (const QString &path : known) {
+        if (!present.contains(path)) {
+            removeDevice(path);
+        }
+    }
+
+    if (had != hasDevices()) {
+        Q_EMIT hasDevicesChanged();
+    }
+}
+
+bool GamepadListener::addDevice(const QString &path)
+{
+    const int fd = ::open(path.toLocal8Bit().constData(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        // Most nodes are simply not readable by us, which is expected
+        return false;
+    }
+
+    libevdev *dev = nullptr;
+    if (libevdev_new_from_fd(fd, &dev) != 0) {
+        ::close(fd);
+        return false;
+    }
+
+    // A gamepad has the south face button plus either a stick or a d-pad hat.
+    // This is the same shape of check libinput uses to classify joysticks.
+    const bool isGamepad = libevdev_has_event_code(dev, EV_KEY, BTN_SOUTH)
+        && (libevdev_has_event_code(dev, EV_ABS, ABS_X) || libevdev_has_event_code(dev, EV_ABS, ABS_HAT0X)
+            || libevdev_has_event_code(dev, EV_KEY, BTN_DPAD_LEFT));
+
+    if (!isGamepad) {
+        libevdev_free(dev);
+        ::close(fd);
+        return false;
+    }
+
+    auto *device = new Device;
+    device->path = path;
+    device->fd = fd;
+    device->dev = dev;
+
+    const auto calibrate = [dev](int code, int &center, int &enter, int &leave) {
+        const int min = libevdev_get_abs_minimum(dev, code);
+        const int max = libevdev_get_abs_maximum(dev, code);
+        center = (min + max) / 2;
+        const int range = (max - min) / 2;
+        enter = int(range * STICK_ENTER);
+        leave = int(range * STICK_LEAVE);
+    };
+
+    if (libevdev_has_event_code(dev, EV_ABS, ABS_X)) {
+        calibrate(ABS_X, device->stickCenterX, device->stickEnterX, device->stickLeaveX);
+    }
+    if (libevdev_has_event_code(dev, EV_ABS, ABS_Y)) {
+        calibrate(ABS_Y, device->stickCenterY, device->stickEnterY, device->stickLeaveY);
+    }
+
+    device->notifier = new QSocketNotifier(fd, QSocketNotifier::Read, this);
+    connect(device->notifier, &QSocketNotifier::activated, this, [this, device] {
+        readFrom(device);
+    });
+
+    m_devices.insert(path, device);
+    applyGrab(device);
+
+    qCDebug(PlasmaKeyboard) << "Using game controller" << libevdev_get_name(dev) << "at" << path;
+    return true;
+}
+
+void GamepadListener::removeDevice(const QString &path)
+{
+    Device *device = m_devices.take(path);
+    if (!device) {
+        return;
+    }
+
+    // We may be inside the notifier's own signal emission when a device
+    // disappears mid-read, so unhook it now and destroy it once we are out.
+    device->notifier->setEnabled(false);
+    device->notifier->disconnect(this);
+    device->notifier->deleteLater();
+
+    libevdev_free(device->dev);
+    ::close(device->fd);
+    delete device;
+
+    if (m_devices.isEmpty()) {
+        // The controller went away mid-press
+        setNavigationKey(0);
+        setRepeatAction(m_repeatAction, false);
+        setShiftHeld(false);
+    }
+}
+
+void GamepadListener::closeAll()
+{
+    const bool had = hasDevices();
+
+    const QStringList paths = m_devices.keys();
+    for (const QString &path : paths) {
+        removeDevice(path);
+    }
+
+    setNavigationKey(0);
+    setRepeatAction(m_repeatAction, false);
+    setShiftHeld(false);
+
+    if (had) {
+        Q_EMIT hasDevicesChanged();
+    }
+}
+
+void GamepadListener::readFrom(Device *device)
+{
+    input_event event;
+    int status = 0;
+
+    do {
+        status = libevdev_next_event(device->dev, LIBEVDEV_READ_FLAG_NORMAL, &event);
+
+        if (status == LIBEVDEV_READ_STATUS_SYNC) {
+            // Dropped events: resynchronise and apply the recovered state
+            while (status == LIBEVDEV_READ_STATUS_SYNC) {
+                handleEvent(device, event);
+                status = libevdev_next_event(device->dev, LIBEVDEV_READ_FLAG_SYNC, &event);
+            }
+        } else if (status == LIBEVDEV_READ_STATUS_SUCCESS) {
+            handleEvent(device, event);
+        }
+    } while (status == LIBEVDEV_READ_STATUS_SUCCESS || status == LIBEVDEV_READ_STATUS_SYNC);
+
+    if (status != -EAGAIN) {
+        // The device was unplugged or errored out
+        const QString path = device->path;
+        removeDevice(path);
+        Q_EMIT hasDevicesChanged();
+    }
+}
+
+void GamepadListener::handleEvent(Device *device, const input_event &event)
+{
+    switch (event.type) {
+    case EV_KEY:
+        // value 2 is the kernel's own auto-repeat, we do our own
+        if (event.value != 2) {
+            handleButton(event.code, event.value != 0);
+        }
+        break;
+    case EV_ABS:
+        handleAxis(device, event.code, event.value);
+        break;
+    default:
+        break;
+    }
+}
+
+bool GamepadListener::handleButton(int code, bool pressed)
+{
+    switch (code) {
+    // D-pad reported as buttons (DualSense, some 8BitDo modes)
+    case BTN_DPAD_LEFT:
+        m_dpadLeft = pressed;
+        updateDirection();
+        return true;
+    case BTN_DPAD_RIGHT:
+        m_dpadRight = pressed;
+        updateDirection();
+        return true;
+    case BTN_DPAD_UP:
+        m_dpadUp = pressed;
+        updateDirection();
+        return true;
+    case BTN_DPAD_DOWN:
+        m_dpadDown = pressed;
+        updateDirection();
+        return true;
+
+    // A: type the highlighted key
+    case BTN_SOUTH:
+        if (pressed) {
+            Q_EMIT navigationKeyPressed(Qt::Key_Return);
+        } else {
+            Q_EMIT navigationKeyReleased(Qt::Key_Return);
+        }
+        return true;
+
+    // B: close the keyboard
+    case BTN_EAST:
+        if (pressed) {
+            Q_EMIT actionTriggered(Hide, false);
+        }
+        return true;
+
+    // X: backspace, repeating while held
+    case BTN_WEST:
+        setRepeatAction(Backspace, pressed);
+        return true;
+
+    // Y: space
+    case BTN_NORTH:
+        if (pressed) {
+            Q_EMIT actionTriggered(Space, false);
+        }
+        return true;
+
+    // Triggers, on the devices that report them as buttons rather than axes.
+    // Left is shift, right is enter.
+    case BTN_TL2:
+        setShiftHeld(pressed);
+        return true;
+    case BTN_TR2:
+        if (pressed) {
+            Q_EMIT actionTriggered(Enter, false);
+        }
+        return true;
+
+    // Home / Guide belongs to the shell, never to the keyboard: on this setup
+    // plasma-remotecontrollers turns it into the key that opens Plasma
+    // Bigscreen's home overlay. An exclusive grab would swallow it, so drop the
+    // grab for as long as it is held and take no action of our own.
+    case BTN_MODE:
+        m_homeHeld = pressed;
+        updateGrab();
+        return true;
+
+    // The bumpers are unbound on the Steam keyboard, so leave them to the
+    // application behind us when we are not grabbing.
+    default:
+        return false;
+    }
+}
+
+void GamepadListener::handleAxis(Device *device, int code, int value)
+{
+    switch (code) {
+    case ABS_HAT0X:
+        m_hatX = value > 0 ? 1 : (value < 0 ? -1 : 0);
+        updateDirection();
+        break;
+    case ABS_HAT0Y:
+        m_hatY = value > 0 ? 1 : (value < 0 ? -1 : 0);
+        updateDirection();
+        break;
+    case ABS_X:
+        m_stickX = axisDirection(value, device->stickCenterX, device->stickEnterX, device->stickLeaveX, m_stickX);
+        updateDirection();
+        break;
+    case ABS_Y:
+        m_stickY = axisDirection(value, device->stickCenterY, device->stickEnterY, device->stickLeaveY, m_stickY);
+        updateDirection();
+        break;
+    case ABS_Z:
+    case ABS_RZ: {
+        if (!hasAnalogTriggers(device)) {
+            break;
+        }
+
+        const int min = libevdev_get_abs_minimum(device->dev, code);
+        const int max = libevdev_get_abs_maximum(device->dev, code);
+        if (max <= min) {
+            break;
+        }
+
+        const bool active = double(value - min) / double(max - min) > TRIGGER_THRESHOLD;
+        const bool isLeft = code == ABS_Z;
+        bool &state = isLeft ? m_triggerLeft : m_triggerRight;
+        if (active == state) {
+            break;
+        }
+        state = active;
+
+        if (isLeft) {
+            // Left trigger is shift, held rather than toggled
+            setShiftHeld(active);
+        } else if (active) {
+            Q_EMIT actionTriggered(Enter, false);
+        }
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+bool GamepadListener::hasAnalogTriggers(const Device *device)
+{
+    // A pad with a real right stick reports it as ABS_RX/ABS_RY, which leaves
+    // ABS_Z/ABS_RZ free to be the analog triggers. Pads without ABS_RX use
+    // ABS_Z/ABS_RZ for the right stick instead, and have no analog triggers.
+    return libevdev_has_event_code(device->dev, EV_ABS, ABS_RX);
+}
+
+void GamepadListener::setShiftHeld(bool held)
+{
+    if (held == m_shiftHeld) {
+        return;
+    }
+
+    m_shiftHeld = held;
+    Q_EMIT shiftHeldChanged(held);
+}
+
+int GamepadListener::axisDirection(int value, int center, int enter, int leave, int previous)
+{
+    const int offset = value - center;
+    const int threshold = previous == 0 ? enter : leave;
+
+    if (offset > threshold) {
+        return 1;
+    }
+    if (offset < -threshold) {
+        return -1;
+    }
+    return 0;
+}
+
+void GamepadListener::updateDirection()
+{
+    const int dpadX = m_dpadLeft ? -1 : (m_dpadRight ? 1 : 0);
+    const int dpadY = m_dpadUp ? -1 : (m_dpadDown ? 1 : 0);
+
+    // The d-pad wins over the stick so a resting stick cannot fight it
+    const int x = m_hatX != 0 ? m_hatX : (dpadX != 0 ? dpadX : m_stickX);
+    const int y = m_hatY != 0 ? m_hatY : (dpadY != 0 ? dpadY : m_stickY);
+
+    int key = 0;
+    if (x < 0) {
+        key = Qt::Key_Left;
+    } else if (x > 0) {
+        key = Qt::Key_Right;
+    } else if (y < 0) {
+        key = Qt::Key_Up;
+    } else if (y > 0) {
+        key = Qt::Key_Down;
+    }
+
+    setNavigationKey(key);
+}
+
+void GamepadListener::setNavigationKey(int key)
+{
+    if (key == m_navigationKey) {
+        return;
+    }
+
+    if (m_navigationKey != 0) {
+        Q_EMIT navigationKeyReleased(m_navigationKey);
+    }
+
+    m_navigationKey = key;
+
+    if (key != 0) {
+        Q_EMIT navigationKeyPressed(key);
+    }
+
+    restartRepeatTimer();
+}
+
+void GamepadListener::setRepeatAction(Action action, bool active)
+{
+    if (active) {
+        m_repeatAction = action;
+        m_repeatActionActive = true;
+        Q_EMIT actionTriggered(action, false);
+    } else if (m_repeatActionActive && m_repeatAction == action) {
+        m_repeatActionActive = false;
+    } else {
+        return;
+    }
+
+    restartRepeatTimer();
+}
+
+void GamepadListener::restartRepeatTimer()
+{
+    // A held direction takes priority over a held button
+    if (m_navigationKey == 0 && !m_repeatActionActive) {
+        m_repeatTimer.stop();
+        m_repeating = false;
+        return;
+    }
+
+    m_repeating = false;
+    m_repeatTimer.start(REPEAT_DELAY_MS);
+}
+
+void GamepadListener::onRepeatTimeout()
+{
+    if (!m_repeating) {
+        m_repeating = true;
+        m_repeatTimer.setInterval(REPEAT_INTERVAL_MS);
+    }
+
+    if (m_navigationKey != 0) {
+        Q_EMIT navigationKeyPressed(m_navigationKey);
+    } else if (m_repeatActionActive) {
+        Q_EMIT actionTriggered(m_repeatAction, true);
+    } else {
+        m_repeatTimer.stop();
+    }
+}
+
