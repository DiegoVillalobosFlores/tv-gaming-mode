+ * highlighted key, B closes the keyboard, X is backspace, Y is space, the left
+ * trigger is shift and the right trigger is enter. The bumpers are unbound
+ * there, so they are unbound here too.
+ *
+ * The Home / Guide button is never ours: it belongs to the shell. The exclusive
+ * grab is dropped for as long as it is held so the rest of the session keeps
+ * receiving it.
+ */
+class GamepadListener : public QObject
+{
+    Q_OBJECT
+
+public:
+    enum Action {
+        Backspace,
+        Space,
+        Enter,
+        Hide,
+    };
+    Q_ENUM(Action)
+
+    explicit GamepadListener(QObject *parent = nullptr);
+    ~GamepadListener() override;
+
+    /**
+     * Whether controllers are watched at all. Disabling closes every device.
+     */
+    void setEnabled(bool enabled);
+    bool isEnabled() const;
+
+    /**
+     * Whether to take exclusive control (EVIOCGRAB) of the controllers.
+     *
+     * While grabbing, controller input no longer reaches the application
+     * behind the keyboard, which is what makes typing with a controller usable
+     * on top of a game. It should only be set while the panel is on screen.
+     */
+    void setGrabbing(bool grabbing);
+    bool isGrabbing() const;
+
+    /**
+     * Whether at least one controller is currently open.
+     */
+    bool hasDevices() const;
+
+Q_SIGNALS:
+    /**
+     * A navigation key (arrow keys or Return) was pressed on the controller.
+     *
+     * Repeats while a direction is held down.
+     */
+    void navigationKeyPressed(int key);
+    void navigationKeyReleased(int key);
+
+    /**
+     * A controller button mapped to a keyboard action was pressed.
+     *
+     * @p isRepeat is true for the presses synthesised while the button is held
+     * down, so that one-shot actions can ignore them.
+     */
+    void actionTriggered(GamepadListener::Action action, bool isRepeat);
+
+    /**
+     * The shift button is held down or was let go.
+     */
+    void shiftHeldChanged(bool held);
+
+    void hasDevicesChanged();
+
+private:
+    struct Device {
+        QString path;
+        int fd = -1;
+        libevdev *dev = nullptr;
+        QSocketNotifier *notifier = nullptr;
+
+        // Thresholds for the left stick, derived from the axis ranges reported
+        // by the device.
+        int stickEnterX = 0;
+        int stickLeaveX = 0;
+        int stickCenterX = 0;
+        int stickEnterY = 0;
+        int stickLeaveY = 0;
+        int stickCenterY = 0;
+    };
+
+    void rescan();
+    bool addDevice(const QString &path);
+    void removeDevice(const QString &path);
+    void closeAll();
+    void applyGrab(Device *device);
+    void updateGrab();
+
+    /**
+     * Whether we are actually holding the devices exclusively right now.
+     */
+    bool effectivelyGrabbing() const;
+
+    void readFrom(Device *device);
+    void handleEvent(Device *device, const input_event &event);
+    bool handleButton(int code, bool pressed);
+    void handleAxis(Device *device, int code, int value);
+    void setShiftHeld(bool held);
+
+    /**
+     * Whether ABS_Z / ABS_RZ are the analog triggers on this device rather
+     * than a second stick.
+     */
+    static bool hasAnalogTriggers(const Device *device);
+
+    void updateDirection();
+    void setNavigationKey(int key);
+    void setRepeatAction(Action action, bool active);
+    void restartRepeatTimer();
+    void onRepeatTimeout();
+
+    /**
+     * Hysteresis for analog axes, so a stick resting near the threshold does
+     * not spam direction changes.
+     */
+    static int axisDirection(int value, int center, int enter, int leave, int previous);
+
+    QHash<QString, Device *> m_devices;
+    QFileSystemWatcher *const m_watcher;
+    QTimer m_rescanTimer;
+    QTimer m_repeatTimer;
+
+    bool m_enabled = false;
+    bool m_grabbing = false;
+
+    // Direction sources, combined by updateDirection()
+    int m_hatX = 0;
+    int m_hatY = 0;
+    bool m_dpadLeft = false;
+    bool m_dpadRight = false;
+    bool m_dpadUp = false;
+    bool m_dpadDown = false;
+    int m_stickX = 0;
+    int m_stickY = 0;
+    bool m_triggerLeft = false;
+    bool m_triggerRight = false;
+    bool m_shiftHeld = false;
+    bool m_homeHeld = false;
+
+    int m_navigationKey = 0;
+    Action m_repeatAction = Backspace;
+    bool m_repeatActionActive = false;
+    bool m_repeating = false;
+};
